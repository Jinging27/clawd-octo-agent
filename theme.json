{
  "schemaVersion": 1,
  "name": "小章鱼多线程 Agent",
  "author": "TabBit",
  "version": "1.0.0",
  "description": "30 CSS-animated SVG states — cyan body, purple tentacles",

  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 200,
    "height": 200
  },

  "layout": {
    "contentBox": {
      "x": 30,
      "y": 20,
      "width": 140,
      "height": 150
    },
    "centerX": 100,
    "baselineY": 175,
    "visibleHeightRatio": 0.5,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": true,
    "states": ["idle"],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.4,
    "maxOffset": 8,
    "trackingLayers": {
      "eyes": {
        "ids": ["pupil-left", "pupil-right"],
        "maxOffset": 8,
        "ease": 0.2
      }
    }
  },

  "sleepSequence": {
    "mode": "full"
  },

  "states": {
    "idle": [
      "octo-idle-follow.svg"
    ],
    "yawning": [
      "octo-sleep-yawn.svg"
    ],
    "dozing": [
      "octo-sleep-doze.svg"
    ],
    "collapsing": [
      "octo-sleep-collapse.svg"
    ],
    "sleeping": [
      "octo-sleep-sleeping.svg"
    ],
    "waking": [
      "octo-sleep-wake.svg"
    ],
    "thinking": [
      "octo-working-thinking.svg"
    ],
    "working": [
      "octo-working-typing.svg"
    ],
    "juggling": [
      "octo-working-juggling.svg"
    ],
    "groove": [
      "octo-working-headphones-groove.svg"
    ],
    "sweeping": [
      "octo-notif-sweeping.svg"
    ],
    "carrying": [
      "octo-notif-carrying.svg"
    ],
    "error": [
      "octo-notif-error.svg"
    ],
    "attention": [
      "octo-notif-happy.svg"
    ],
    "notification": [
      "octo-notif-notification.svg"
    ]
  },

  "workingTiers": [
    { "minSessions": 3, "file": "octo-working-building.svg" },
    { "minSessions": 2, "file": "octo-working-juggling.svg" },
    { "minSessions": 1, "file": "octo-working-typing.svg" }
  ],

  "jugglingTiers": [
    { "minSessions": 2, "file": "octo-working-headphones-groove.svg" },
    { "minSessions": 1, "file": "octo-working-juggling.svg" }
  ],

  "reactions": {
    "drag":       { "file": "octo-react-drag.svg" },
    "clickLeft":  { "file": "octo-react-left.svg",  "duration": 2500 },
    "clickRight": { "file": "octo-react-right.svg", "duration": 2500 },
    "double":     { "files": ["octo-react-double.svg"], "duration": 3000 },
    "annoyed":    { "file": "octo-react-annoyed.svg", "duration": 3500 }
  },

  "hitBoxes": {
    "default":  { "x": 50, "y": 30, "w": 100, "h": 140 },
    "sleeping": { "x": 40, "y": 60, "w": 120, "h": 100 }
  },

  "sleepingHitboxFiles": [
    "octo-sleep-sleeping.svg",
    "octo-sleep-collapse.svg"
  ],

  "miniMode": {
    "supported": true,
    "states": {
      "mini-idle":        ["octo-mini-idle.svg"],
      "mini-alert":       ["octo-mini-alert.svg"],
      "mini-happy":       ["octo-mini-happy.svg"],
      "mini-enter":       ["octo-mini-enter.svg"],
      "mini-peek":        ["octo-mini-peek.svg"],
      "mini-crabwalk":    ["octo-mini-crabwalk.svg"],
      "mini-enter-sleep": ["octo-mini-enter-sleep.svg"],
      "mini-sleep":       ["octo-mini-sleep.svg"],
      "mini-typing":      ["octo-mini-typing.svg"]
    }
  },

  "timings": {
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  }
}
